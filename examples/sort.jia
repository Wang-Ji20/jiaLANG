// Insertion sort on a global array, printing before and after.
//   jiac -O2 examples/sort.jia -o sort && ./sort
int printf(char *fmt, ...);

int data[10] = {31, 4, 15, 92, 65, 35, 89, 79, 32, 38};

void sort(int *a, int n) {
  int i = 1;
  while (i < n) {
    int key = a[i];
    int j = i - 1;
    while (j >= 0 && a[j] > key) {
      a[j + 1] = a[j];
      j = j - 1;
    }
    a[j + 1] = key;
    i = i + 1;
  }
}

void show(int *a, int n) {
  int i = 0;
  while (i < n) {
    printf("%d ", a[i]);
    i = i + 1;
  }
  printf("\n");
}

int main() {
  show(data, 10);
  sort(data, 10);
  show(data, 10);
  return 0;
}
