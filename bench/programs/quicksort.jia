// Recursion, pointers, and unpredictable branches: quicksort of
// pseudo-random numbers. The generator avoids signed overflow.
int printf(char *fmt, ...);

int data[1000000];

void quicksort(int *a, int lo, int hi) {
  while (lo < hi) {
    int pivot = a[(lo + hi) / 2];
    int i = lo, j = hi;
    while (i <= j) {
      while (a[i] < pivot) i = i + 1;
      while (a[j] > pivot) j = j - 1;
      if (i <= j) {
        int t = a[i];
        a[i] = a[j];
        a[j] = t;
        i = i + 1;
        j = j - 1;
      }
    }
    if (j - lo < hi - i) {
      quicksort(a, lo, j);
      lo = i;
    } else {
      quicksort(a, i, hi);
      hi = j;
    }
  }
}

int main() {
  int n = 1000000, x = 1, i = 0;
  while (i < n) {
    x = (x * 1103 + 12345) % 1000003;
    data[i] = x;
    i = i + 1;
  }
  quicksort(data, 0, n - 1);
  i = 1;
  int sorted = 1;
  while (i < n) {
    if (data[i - 1] > data[i]) sorted = 0;
    i = i + 1;
  }
  printf("sorted %d min %d median %d max %d\n", sorted, data[0], data[n / 2], data[n - 1]);
  return 0;
}
