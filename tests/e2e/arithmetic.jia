// Integer and floating arithmetic, conversions, and wrap-around, checked
// against the system C compiler at -O0 and -O2.
// RUN: %cc -w -x c %s -o %t.ref && %t.ref > %t.expected
// RUN: %jiac %s -o %t && %t > %t.actual && diff %t.expected %t.actual
// RUN: %jiac -O2 %s -o %t.opt && %t.opt > %t.actual2 && diff %t.expected %t.actual2
// RUN: cat %t.actual
// CHECK: div 3 -3 rem 1 -1
// CHECK: char 44 -128
// CHECK: float 3.75 2
int printf(char *fmt, ...);

int main() {
  int a = 7, b = -7;
  char c = 300;            // wraps to 44
  char d = 127;
  float f = 1.5;
  int truncated = 2.9;     // float to int truncates toward zero
  printf("div %d %d rem %d %d\n", a / 2, b / 2, a % 2, b % 2);
  printf("char %d %d\n", c, (char)(d + 1));
  printf("float %.2f %d\n", f * 2 + 0.75, truncated);
  printf("mixed %.3f %.3f\n", a / 2.0, (float)a / 2);
  printf("unary %d %d %d %d\n", -a, +b, !a, !0);
  printf("compare %d %d %d %d\n", a > b, a <= b, f == 1.5, f != 1.5);
  printf("precedence %d %d\n", 2 + 3 * 4 - 6 / 2 % 4, (2 + 3) * (4 - 6));
  return 0;
}
