// Local and global arrays, initializers, 2-D arrays, sizeof, and arrays
// passed to functions.
// RUN: %cc -w -x c %s -o %t.ref && %t.ref > %t.expected
// RUN: %jiac %s -o %t && %t > %t.actual && diff %t.expected %t.actual
// RUN: %jiac -O2 %s -o %t.opt && %t.opt > %t.actual2 && diff %t.expected %t.actual2
// RUN: cat %t.actual
// CHECK: sum 15
// CHECK: grid 0 1 2 / 10 11 12
// CHECK: sizes 20 4 6 24
int printf(char *fmt, ...);

int global[4] = {1, 2};
int matrix[2][3];

int sum(int *a, int n) {
  int s = 0, i = 0;
  while (i < n) {
    s = s + a[i];
    i = i + 1;
  }
  return s;
}

int main() {
  int local[] = {1, 2, 3, 4, 5};
  printf("sum %d\n", sum(local, 5));
  printf("global %d %d %d %d\n", global[0], global[1], global[2], global[3]);

  int i = 0;
  while (i < 2) {
    int j = 0;
    while (j < 3) {
      matrix[i][j] = i * 10 + j;
      j = j + 1;
    }
    i = i + 1;
  }
  printf("grid %d %d %d / %d %d %d\n", matrix[0][0], matrix[0][1], matrix[0][2],
         matrix[1][0], matrix[1][1], matrix[1][2]);

  char word[] = "hello";
  int nested[2][3] = {{1, 2}, {4}};
  printf("sizes %d %d %d %d\n", sizeof local, sizeof local[0], sizeof word,
         sizeof nested);
  printf("nested %d %d %d %d\n", nested[0][1], nested[0][2], nested[1][0], nested[1][2]);
  printf("index %d\n", 2[local]);
  return 0;
}
